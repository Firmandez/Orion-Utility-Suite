{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion Utility Suite",
  "version": "0.6.2",
  "identifier": "com.firmandez.orionutilitysuite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orion Utility Suite",
        "width": 1480,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/tools/yt-dlp/*"
    ],
    "shortDescription": "Offline-first desktop utility suite for everyday local workflows.",
    "longDescription": "Orion Utility Suite is a cross-platform offline-first desktop workspace by Firmandez for QR generation, image conversion, PDF tools, hashing, text utilities, network diagnostics, and developer helpers."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/Firmandez/Orion-Utility-Suite/main/updater/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDQTQxMTZEQ0U1NjZBNUEKUldSYWFsYk9iUkdrdkwzcVlQMzZMWks3SmhvSVlOYTZ6MzhSUEFQbkZ4dUR5L1N0UDNadDMxQnYK"
    }
  }
}
