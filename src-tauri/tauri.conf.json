{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion Utility Suite",
  "version": "0.2.3",
  "identifier": "com.firmandez.orionutilitysuite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orion Utility Suite",
        "width": 1480,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pdfium/linux-x64/libpdfium.so",
      "resources/pdfium/macos-arm64/libpdfium.dylib",
      "resources/pdfium/macos-univ/libpdfium.dylib",
      "resources/pdfium/macos-x64/libpdfium.dylib",
      "resources/pdfium/windows-x64/pdfium.dll"
    ],
    "shortDescription": "Offline-first desktop utility suite for everyday local workflows.",
    "longDescription": "Orion Utility Suite is a cross-platform offline-first desktop workspace by Firmandez for QR generation, image conversion, PDF tools, hashing, text utilities, network diagnostics, and developer helpers."
  }
}
