    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^8.0.0"
  }
