  "homepage": "https://github.com/Firmandez",
  "description": "Modern desktop utility suite for files, images, PDFs, QR codes, text, and network checks.",
  "type": "module",
  "scripts": {
    "sync:version": "node scripts/sync-version.mjs",
    "predev": "npm run sync:version",
    "prebuild": "npm run sync:version",
    "prepreview": "npm run sync:version",
    "pretauri": "npm run sync:version",
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "tauri:installer": "node scripts/run-tauri-build.mjs build -b nsis",
    "tauri:portable": "node scripts/run-tauri-build.mjs build --no-bundle",
    "tauri": "node scripts/run-tauri-build.mjs",
    "git:tag": "node scripts/git-tag.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.1.1",
    "@fontsource-variable/space-grotesk": "^5.1.1",
